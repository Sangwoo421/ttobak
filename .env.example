# 복사해서 .env 로 저장. .env 는 절대 커밋하지 않는다.

# ---- 외부 AI API ----
OPENAI_API_KEY=sk-...
# STT / TTS / LLM 모델 (필요 시 교체)
STT_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
LLM_PROVIDER=openai            # openai | anthropic | stub
OPENAI_LLM_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-opus-5

# ---- 음성 대응 레이어 파라미터 ----
SENIOR_SILENCE_MS=2000         # 어르신 모드 발화 종료 침묵 대기
BASELINE_SILENCE_MS=700        # 비교용 기본값
MATCH_ACCEPT=0.80              # 자모 유사도 채택 기준
MATCH_ASK=0.60                 # 이 이상이면 되묻기, 미만이면 버튼
MATCH_TIE_GAP=0.10             # 상위 두 후보 차이가 이보다 작으면 LLM 선택
INTENT_MIN_CONF=0.70

# ---- 서비스 주소 ----
BACKEND_BASE_URL=http://localhost:8080
AI_BASE_URL=http://localhost:8000
BACKEND_MODE=http              # http | mock  (mock = docs/contracts/examples 사용)

# ---- DB (backend / docker-compose 공용) ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ttobak
MYSQL_USER=ttobak
MYSQL_PASSWORD=ttobak
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ---- 해커톤 간편 로그인 ----
# 실제 서비스에서는 인증 서버/FIDO로 교체한다. 저장소에는 운영 PIN을 넣지 않는다.
DEMO_SIMPLE_PIN=123456
AUTH_SESSION_MINUTES=30

# ---- Google Gemini ----
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_LLM_MODEL=gemini-3.5-flash
GEMINI_TTS_VOICE=Kore
